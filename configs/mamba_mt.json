    "run_sd_ddof": 1,
    "test_requires_explicit_unlock": true,
    "test_ensemble": "none_individual_run_checkpoints_all_10_reported",
    "external_validation": false,
    "prediction_model": "student",
    "tile_size": 64,
    "tile_stride": 32,
    "overlap_merge": "mean_probability",
    "test_time_augmentation": false
