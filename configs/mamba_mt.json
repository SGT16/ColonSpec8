{
  "model": {
    "patch_size": 64,
    "stem_channels": 8,
    "spatial_grid": 8,
    "d_model": 32,
    "d_state": 16,
    "d_conv": 4,
    "expand": 2,
    "spectral_directions": 2,
    "spatial_directions": 4,
    "mamba_class": "mamba_ssm.Mamba",
    "allow_fallback": false,
    "input_bands_preserved": true,
    "decoder_revision": "shared_prepool_32x32_skip_v1",
    "unet_widths": [
      32,
      64,
      128,
      256
    ],
    "unet_normalization": "GroupNorm",
    "pretrained": false,
    "architecture": "multiscale_mamba_v1",
    "multiscale_widths": [
      8,
      16,
      24,
      32
    ]
  },
  "train": {
    "effective_batch_size": 32,
    "physical_batch_size": 2,
    "max_epochs": 100,
    "patience": 15,
    "steps_per_epoch": 128,
    "optimizer": "AdamW",
    "lr": 0.001,
    "weight_decay": 0.0001,
    "checkpoint_metric": "val_image_macro_f1",
    "num_workers": 4,
    "prefetch_factor": 4,
    "cache_limit_gib": 16,
    "cache_scope": "global_not_per_worker",
