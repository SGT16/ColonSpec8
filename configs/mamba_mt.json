  "ssl": {
    "warmup_epochs": 5,
    "ramp_epochs": 10,
    "ema_teacher": 0.99,
    "confidence_threshold": 0.95,
    "lambda_u_max": 1.0,
    "lambda_proto_max": 0.1,
    "prototype_momentum": 0.9,
    "prototype_temperature": 0.2,
    "prototype_source": "revealed_train_teacher_features_only",
    "prototype_balance": "equal_contributing_images_within_class"
  },
  "augment": {
    "online_train_only": true,
    "flip": true,
    "rotate90": true,
    "illumination_scale": [
      0.95,
      1.05
